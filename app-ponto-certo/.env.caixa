# ===== CONFIGURAÇÃO MÁQUINA CAIXA =====
# Esta máquina terá acesso restrito (apenas vendas e devoluções)

MODE=production

# Rol da máquina
MARIADB_ROLE=caixa

# ===== MariaDB Server =====
# Apontar para o MESMO IP do servidor onde MariaDB está instalado
MARIADB_HOST=192.168.1.100  # Altere para o IP real (MESMO DA MÁQUINA GERENTE)
MARIADB_PORT=3306

# Credenciais do usuário CAIXA
# Este usuário tem permissões LIMITADAS (apenas vendas, devoluções)
MARIADB_USER=caixa
MARIADB_PASSWORD=SenhaCaixa@2025
MARIADB_DATABASE=ponto_certo

# ===== Geral =====
DEBUG=False
LOG_LEVEL=INFO
