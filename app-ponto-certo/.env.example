# ===== CONFIGURAÇÃO GERENTE + CAIXA =====
# Máquina 1: MARIADB_ROLE=gerente (acesso total)
# Máquina 2: MARIADB_ROLE=caixa (apenas vendas/devoluções)

MODE=production
MARIADB_ROLE=gerente  # Opções: gerente, caixa

# ===== MariaDB (Obrigatório para 2+ computadores) =====
# IP do servidor MariaDB (pode ser qualquer máquina na rede)
MARIADB_HOST=192.168.1.100  # Alterar para o IP real do seu servidor
MARIADB_PORT=3306
MARIADB_USER=gerente  # gerente ou caixa (conforme MARIADB_ROLE)
MARIADB_PASSWORD=sua_senha_aqui
MARIADB_DATABASE=ponto_certo

# ===== Configurações Gerais =====
DEBUG=True
LOG_LEVEL=INFO

# Configurações de Usuário (opcional)
# ADMIN_USER=admin
# ADMIN_PASSWORD=admin
