# ===== CONFIGURAÇÃO MÁQUINA GERENTE =====
# Esta máquina terá acesso total a todos os módulos

MODE=production

# Rol da máquina
MARIADB_ROLE=gerente

# ===== MariaDB Server =====
# Apontar para o IP do servidor onde MariaDB está instalado
MARIADB_HOST=192.168.1.100  # Altere para o IP real
MARIADB_PORT=3306

# Credenciais do usuário GERENTE
# Este usuário tem permissões totais no banco
MARIADB_USER=gerente
MARIADB_PASSWORD=SenhaGerente@2025
MARIADB_DATABASE=ponto_certo

# ===== Geral =====
DEBUG=False
LOG_LEVEL=INFO
